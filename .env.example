# =============================================================================
# GrowthLoop - 环境变量配置
# =============================================================================
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env
#
# 注意：.env 已被 .gitignore 排除，不会被提交到仓库
# =============================================================================

# -----------------------------------------------------------------------------
# LLM 大模型配置（必填）
# -----------------------------------------------------------------------------
# 兼容 OpenAI Chat Completions API 格式的端点地址
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# API 密钥
LLM_API_KEY=sk-your-api-key-here

# 模型名称（可选，默认 Claude-sonnet-4.6）
# 支持任何兼容 OpenAI API 格式的模型，如：
#   gpt-4o / gpt-4o-mini / claude-sonnet-4-20250514 / deepseek-chat 等
LLM_MODEL=Claude-sonnet-4.6
